<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AmllMvStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- 非打包（unpackaged）模式：直接双击 exe 即可运行，无需 MSIX 安装 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- 自动引入 System / System.IO / System.Linq / System.Threading.Tasks 等常用命名空间 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AmllMvStudio</AssemblyName>
    <Version>0.2.2</Version>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <FileVersion>0.2.2.0</FileVersion>
    <Product>AMLL Lyric MV Studio</Product>
    <Title>AMLL Lyric MV Studio</Title>
    <AssemblyTitle>AMLL Lyric MV Studio</AssemblyTitle>
    <FileDescription>AMLL Lyric MV Studio</FileDescription>
    <Description>Create lyric music videos with Apple Music Like Lyrics visuals.</Description>
    <Authors>Cplay00</Authors>
    <Company>Cplay00</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\app.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\installer\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\installer\NOTICE.txt" Link="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\installer\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\dist\**\*" Link="runtime\content\dist\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\scripts\render-mv.mjs;..\scripts\render-lib.mjs" Link="runtime\content\scripts\%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\package.json;..\package-lock.json" Link="runtime\content\%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- Locked Vite 7 / Playwright runtime closure for the published Windows x64 renderer. -->
    <None Include="..\node_modules\playwright-core\**\*" Link="runtime\content\node_modules\playwright-core\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\vite\**\*" Link="runtime\content\node_modules\vite\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\fdir\**\*" Link="runtime\content\node_modules\fdir\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\picomatch\**\*" Link="runtime\content\node_modules\picomatch\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\tinyglobby\**\*" Link="runtime\content\node_modules\tinyglobby\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\rollup\**\*" Link="runtime\content\node_modules\rollup\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\@rollup\rollup-win32-x64-msvc\**\*" Link="runtime\content\node_modules\@rollup\rollup-win32-x64-msvc\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\@types\estree\**\*" Link="runtime\content\node_modules\@types\estree\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\esbuild\**\*" Link="runtime\content\node_modules\esbuild\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\@esbuild\win32-x64\**\*" Link="runtime\content\node_modules\@esbuild\win32-x64\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\postcss\**\*" Link="runtime\content\node_modules\postcss\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\picocolors\**\*" Link="runtime\content\node_modules\picocolors\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\nanoid\**\*" Link="runtime\content\node_modules\nanoid\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\node_modules\source-map-js\**\*" Link="runtime\content\node_modules\source-map-js\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\installer\staging\runtime\ffmpeg\ffmpeg.exe" Link="runtime\ffmpeg\ffmpeg.exe"
          CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\installer\staging\runtime\ffmpeg\ffmpeg.exe')" />
    <None Include="$(ProgramFiles)\nodejs\node.exe" Link="runtime\node\node.exe"
          CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(ProgramFiles)\nodejs\node.exe')" />
  </ItemGroup>

  <UsingTask TaskName="PatchPublishedRenderer"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        const string sourceRoot = "const PROJECT_ROOT = resolve(dirname(SCRIPT_PATH), \"..\");";
        const string publishRoot = "const PROJECT_ROOT = resolve(dirname(SCRIPT_PATH), \"..\", \"dist\");";
        const string serverRoot = "      root: PROJECT_ROOT,";
        const string publishServerRoot = "      root: PROJECT_ROOT,\n      appType: \"spa\",\n      configFile: false,";
        string text = File.ReadAllText(FilePath);
        if (text.IndexOf(sourceRoot, StringComparison.Ordinal) < 0 ||
            text.IndexOf(sourceRoot, StringComparison.Ordinal) != text.LastIndexOf(sourceRoot, StringComparison.Ordinal) ||
            text.IndexOf(serverRoot, StringComparison.Ordinal) < 0 ||
            text.IndexOf(serverRoot, StringComparison.Ordinal) != text.LastIndexOf(serverRoot, StringComparison.Ordinal))
        {
          throw new InvalidOperationException("Published renderer patch markers are missing or ambiguous.");
        }
        text = text.Replace(sourceRoot, publishRoot)
                   .Replace(serverRoot, publishServerRoot);
        File.WriteAllText(FilePath, text, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PatchRendererForPublishedDist" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishedRenderer>$(PublishDir)runtime\content\scripts\render-mv.mjs</_PublishedRenderer>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PublishedRenderer)')" Text="Published renderer was not found: $(_PublishedRenderer)" />
    <PatchPublishedRenderer FilePath="$(_PublishedRenderer)" />
  </Target>

  <Target Name="CopyApplicationPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
  </Target>

  <!-- tools/ 与 tests/ 下是独立辅助项目，不参与主程序编译 -->
  <ItemGroup>
    <Compile Remove="tools\**;tests\**" />
    <None Remove="tools\**;tests\**" />
    <Content Remove="tools\**;tests\**" />
    <EmbeddedResource Remove="tools\**;tests\**" />
    <Page Remove="tools\**;tests\**" />
    <ApplicationDefinition Remove="tools\**;tests\**" />
  </ItemGroup>

</Project>
