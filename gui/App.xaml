<Application
    x:Class="AmllMvStudio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WorkbenchPanelBrush" Color="#17171C" />
                    <SolidColorBrush x:Key="WorkbenchPanelStrokeBrush" Color="#34343C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkbenchPanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WorkbenchPanelStrokeBrush" Color="#18000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WorkbenchPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WorkbenchPanelStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="WorkbenchCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WorkbenchPanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WorkbenchPanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="WorkbenchExpanderStyle" TargetType="Expander">
                <Setter Property="Background" Value="{ThemeResource WorkbenchPanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WorkbenchPanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
