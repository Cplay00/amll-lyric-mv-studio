<Window
    x:Class="AmllMvStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:AmllMvStudio.Views"
    Title="AMLL Lyric MV Studio">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <muxc:NavigationView
            x:Name="Nav"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="200"
            SelectionChanged="OnNavSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="预览" Tag="preview" IsSelected="True"
                                         AutomationProperties.Name="预览">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="导出成片" Tag="export"
                                         AutomationProperties.Name="导出成片">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Save" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="About" Tag="about"
                                         AutomationProperties.Name="About">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Grid>
                <views:PreviewPage x:Name="PreviewView" />
                <views:ExportPage x:Name="ExportView" Visibility="Collapsed" />
                <views:AboutPage x:Name="AboutView" Visibility="Collapsed" />
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
