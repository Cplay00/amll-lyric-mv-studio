<UserControl
    x:Class="AmllMvStudio.Views.PreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitleText" Text="实时预览" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="PageSubtitleText" Text="素材或工作台设置变更后将自动刷新舞台。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ReloadButton" Click="OnReload"
                    ToolTipService.ToolTip="立即重新载入预览" AutomationProperties.Name="重新载入预览">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock x:Name="ReloadButtonText" Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource WorkbenchCardStyle}" Margin="0,0,0,16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="PickAudioButton" Click="OnPickAudio"
                        ToolTipService.ToolTip="选择 MP3、FLAC、M4A、AAC、WAV、OGG 或 OPUS 音频">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Audio" /><TextBlock x:Name="AudioButtonText" Text="音频" /></StackPanel>
                </Button>
                <Button Grid.Column="1" x:Name="PickLyricButton" Click="OnPickLyric"
                        ToolTipService.ToolTip="选择 TTML、LRC、YRC 等歌词文件">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Document" /><TextBlock x:Name="LyricButtonText" Text="歌词" /></StackPanel>
                </Button>
                <Button Grid.Column="2" x:Name="PickCoverButton" Click="OnPickCover"
                        ToolTipService.ToolTip="选择 JPG、PNG、WEBP 或 GIF 封面">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Pictures" /><TextBlock x:Name="CoverButtonText" Text="封面" /></StackPanel>
                </Button>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="CurrentAssetsText" Text="当前素材" FontWeight="SemiBold" />
                    <TextBlock x:Name="AssetSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Text="尚未载入素材" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource WorkbenchCardStyle}" Padding="0" CornerRadius="12">
            <Grid>
                <muxc:WebView2 x:Name="Stage" DefaultBackgroundColor="#05050A" NavigationStarting="OnNavigationStarting" NavigationCompleted="OnNavigationCompleted" />
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10" MaxWidth="520" Padding="24">
                    <FontIcon Glyph="&#xE768;" FontSize="38" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="EmptyTitleText" Text="载入素材以开始预览" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyHintText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="先选择音频，再按需添加歌词与封面。预览将使用导出页中的舞台、歌词和背景设置。" />
                    <TextBlock x:Name="BuildHintText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <muxc:ProgressRing x:Name="LoadingRing" IsActive="False" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource WorkbenchCardStyle}" Margin="0,16,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ToStartButton" Click="OnToStart" ToolTipService.ToolTip="回到开头"><SymbolIcon Symbol="Previous" /></Button>
                <Button Grid.Column="1" x:Name="BackButton" Click="OnBack5" ToolTipService.ToolTip="后退 5 秒"><TextBlock Text="−5 s" /></Button>
                <Button Grid.Column="2" x:Name="PlayButton" Click="OnTogglePlay" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="播放或暂停"><SymbolIcon x:Name="PlayIcon" Symbol="Play" /></Button>
                <Button Grid.Column="3" x:Name="ForwardButton" Click="OnForward5" ToolTipService.ToolTip="前进 5 秒"><TextBlock Text="+5 s" /></Button>
                <TextBlock Grid.Column="4" x:Name="TimeText" VerticalAlignment="Center" FontFamily="Consolas" Text="0:00 / 0:00" MinWidth="104" />
                <Slider Grid.Column="5" x:Name="SeekSlider" VerticalAlignment="Center" StepFrequency="0.25"
                        ValueChanged="OnSeekChanged" AutomationProperties.Name="播放进度（秒）" ToolTipService.ToolTip="拖动以定位播放时间" />
                <TextBlock Grid.Column="6" x:Name="FpsText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
